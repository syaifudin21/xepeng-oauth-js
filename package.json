{
    "name": "xepeng-oauth-js",
    "version": "1.1.2",
    "description": "Xepeng OAuth JS SDK for React, Vue and more",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./integration": {
            "types": "./dist/integration/index.d.ts",
            "import": "./dist/integration/index.mjs",
            "require": "./dist/integration/index.js"
        },
        "./vue": {
            "types": "./dist/vue/index.d.ts",
            "import": "./dist/vue/index.mjs",
            "require": "./dist/vue/index.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.mjs",
            "require": "./dist/react/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "eslint src --ext .ts",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "oauth",
        "xepeng",
        "auth",
        "react",
        "vue",
        "sdk",
        "integration",
        "payment"
    ],
    "author": "Xepeng",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.6.0"
    },
    "devDependencies": {
        "@types/node": "^25.6.0",
        "@types/react": "^18.2.48",
        "react": "^18.2.0",
        "tsup": "^8.0.2",
        "typescript": "^5.3.3",
        "vue": "^3.4.15"
    },
    "peerDependencies": {
        "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
        "vue": "^3.0.0"
    },
    "peerDependenciesMeta": {
        "vue": {
            "optional": true
        },
        "react": {
            "optional": true
        }
    }
}
